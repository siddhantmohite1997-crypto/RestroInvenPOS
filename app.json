{
  "expo": {
    "name": "POS",
    "slug": "POS",
    "version": "1.0.0",
    "scheme": "pos",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "siddhantsm.RestoInvenPOS"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-router",
      "expo-status-bar",
      "expo-sharing",
      "expo-mail-composer"
    ],
    "extra": {
      "supabaseApiUrl": "https://restroinvenpos-production.up.railway.app",
      "ocrMode": "offline",
      "ocrEndpointUrl": {},
      "router": {},
      "eas": {
        "projectId": "9f232a7b-84a2-454f-8ad4-0eac4c5e30dc"
      }
    }
  }
}
