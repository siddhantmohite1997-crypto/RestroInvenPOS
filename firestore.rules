rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================================================
    // ADMIN COLLECTION: Only admins can read/write
    // ============================================================================
    match /restaurants/{restaurantId} {
      allow read, write: if request.auth.token.admin == true;

      // Restaurant metadata (name, phone, enabled status, sync timestamp)
      match /{document=**} {
        // Only Cloud Functions can write to restaurant data
        // (verified via service account auth)
        allow read: if request.auth.token.admin == true;
        allow write: if false; // Cloud Functions only
      }
    }

    // ============================================================================
    // MULTI-TENANT DATA COLLECTIONS
    // Structure: restaurants/{restaurantId}/{collection}/{docId}
    // All collections under a restaurant use the same security rule
    // ============================================================================
    match /restaurants/{restaurantId}/{collection}/{document=**} {
      // Only Cloud Functions can write
      // (Mobile app has no direct Firestore access)
      allow read: if request.auth.token.admin == true;
      allow write: if false;
    }

    // ============================================================================
    // STAFF COLLECTION: PINs stored for auth verification
    // Structure: restaurants/{restaurantId}/staff/{staffId}
    // ============================================================================
    match /restaurants/{restaurantId}/staff/{staffId} {
      // Cloud Functions verify PINs here during sync
      // Not readable from app (PINs never exposed)
      allow read: if false;
      allow write: if false; // Only Cloud Functions
    }

    // ============================================================================
    // DENY EVERYTHING ELSE by default
    // ============================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
